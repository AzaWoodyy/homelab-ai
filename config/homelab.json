{
  "hostname": "homelab-ai",
  "openwebui_port": 3000,
  "openwebui_image_tag": "v0.9.6",
  "openwebui": {
    "mcp_initialize_timeout": 30,
    "kb_exec_enabled": false,
    "profile_image_max_data_uri_size": null
  },
  "runtime": {
    "container_backend": "windows-docker",
    "wsl_distro": "Ubuntu",
    "ollama_backend": "windows-process"
  },
  "management": {
    "port": 3081,
    "tailscale_https_port": 8443
  },
  "hermes": {
    "enabled": true,
    "home": "state\\hermes",
    "model": "hermes3:8b",
    "gateway": {
      "enabled": true
    },
    "api_server": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 8642,
      "model_name": "Hermes Agent"
    },
    "discord": {
      "enabled": true,
      "require_mention": true,
      "free_response_channels": ""
    },
    "photon": {
      "enabled": true,
      "sidecar_port": 8789,
      "sidecar_autostart": true,
      "require_mention": false,
      "mention_patterns": ""
    }
  },
  "voice_vision_model": "llava:13b",
  "voice_vision_fallback_model": "qwen3.5:9b",
  "tts": {
    "enabled": true,
    "port": 8000,
    "default_voice": "fr_FR-siwis-medium",
    "fallback_voice": "en_US-lessac-medium"
  },
  "stt": {
    "model": "medium",
    "language": "",
    "auto_update": false
  }
}
